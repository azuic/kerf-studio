{
  "name": "kerf-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Hole, gap and twist-lock cutter for FDM printing — cuts 3D models, generates mating inserts, exports binary STL.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/csg.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kerf-test.mjs --log-level=error && node node_modules/.cache/kerf-test.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.0",
    "@base-ui/react": "^1.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "three": "^0.180.0",
    "three-bvh-csg": "^0.0.17",
    "three-mesh-bvh": "^0.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
