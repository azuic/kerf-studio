{
  "name": "kerf-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Hole, gap and twist-lock cutter for FDM printing — cuts 3D models, generates mating inserts, exports binary STL.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/csg.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kerf-test.mjs --log-level=error && node node_modules/.cache/kerf-test.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "three-bvh-csg": "^0.0.17",
    "three-mesh-bvh": "^0.9.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
